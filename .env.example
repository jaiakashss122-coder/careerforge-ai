# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Create a project at https://supabase.com, then copy these from
# Project Settings -> API. Without them the app runs in clearly labeled local
# preview mode (profile data stays in this browser only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects call this the publishable key. Either variable works.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback origin used when building confirmation redirect URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider (Phase 3). Server-only: never prefix these with NEXT_PUBLIC_ or
# expose them in browser code.
# ---------------------------------------------------------------------------
# Leave AI_API_KEY unset to run the AI Tutor and Prompt Studio in clearly
# labeled demo mode. Setting a key requires AI_MODEL as well; a partial
# configuration produces an explicit error instead of pretending live AI works.
# Supported providers: openai, openai-compatible.
# AI_PROVIDER=openai
# AI_MODEL=
# AI_API_KEY=
# Optional OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
# AI_BASE_URL=
